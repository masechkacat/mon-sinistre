# dependencies
node_modules/

# prisma — клиент генерируется из схемы (npm run prisma:generate)
apps/api/src/generated/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# environment — никогда не коммитим реальные значения
.env
.env.*
!.env.example

# tests & coverage
coverage/
test-results/
playwright-report/

# письма локального режима — в файлах лежат реальные адреса получателей
.mail-outbox/

# logs
*.log
npm-debug.log*

# claude code — личные настройки не коммитим
.claude/settings.local.json

# playwright mcp — служебные файлы и скриншоты в корне
.playwright-mcp/
/*.png

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# python — кеш скриптов скиллов (.agents/)
__pycache__/

# os
.DS_Store
Thumbs.db
