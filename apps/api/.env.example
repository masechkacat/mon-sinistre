# Скопировать в .env и заполнить. Файл .env в git не попадает.
# Значения проверяются при старте (src/config/env.validation.ts):
# пустой секрет или нечисловой порт не дадут приложению запуститься.

# --- база данных ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=mon_sinistre
DB_PASSWORD=
DB_NAME=mon_sinistre

# --- приложение ---
# NODE_ENV задаёт тот, кто запускает процесс, а не этот файл; в списке он ради
# полноты: при значении production приложение требует настоящего транспорта
# почты (см. блок «почта» ниже).
# NODE_ENV=development
# Обе можно не задавать — умолчания те же и живут в схеме
# (src/config/env.validation.ts). Но задать пустой значением нельзя:
# пустая строка валит старт, а не читается как «не задано».
PORT=3001
HOST=0.0.0.0
# Обязательна и абсолютна: из неё каркас писем собирает все ссылки, включая
# обязательную ссылку прекращения писем. Только схема и хост: путевой префикс
# (https://example.fr/app) при сборке ссылки потерялся бы молча, поэтому такое
# значение приложение отвергает на старте.
FRONTEND_URL=http://localhost:3000

# --- секреты ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
# Ключ HMAC-хеша адреса формы veille (счётчик лимита писем, VeilleFormEmail).
VEILLE_EMAIL_HASH_SECRET=
SALT_ROUNDS=12
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# true в продакшене — управляет флагом secure у cookie
HTTPS_ENABLED=false

# --- почта ---
# Адрес отправителя: сменить его — правка этой строки, в коде его нет. Ящика за
# адресом нет — MX домена заглушка, и подвал письма говорит об этом читателю.
MAIL_FROM=no-reply@mon-sinistre.fr
# Домен, верифицированный у провайдера (SPF, DKIM, DMARC). Пока он задан,
# MAIL_FROM обязан быть на нём; обязателен при MAIL_TRANSPORT=scaleway.
MAIL_SENDER_DOMAIN=mon-sinistre.fr
# Чем отправлять: file (по умолчанию) — письмо пишется парой файлов в
# MAIL_OUTBOX_DIR и наружу не уходит; scaleway — Scaleway TEM, обработка адресов
# в ЕС. В продакшене (NODE_ENV=production) file не принимается: приложение
# поднялось бы здоровым и складывало уведомления в файлы.
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=.mail-outbox
# Ниже — только для MAIL_TRANSPORT=scaleway; при нём обязательны, иначе
# приложение не стартует.
SCW_SECRET_KEY=
SCW_PROJECT_ID=
