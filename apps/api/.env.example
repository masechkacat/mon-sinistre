# Скопировать в .env и заполнить. Файл .env в git не попадает.
# Значения проверяются при старте (src/config/env.validation.ts):
# пустой секрет или нечисловой порт не дадут приложению запуститься.

# --- база данных ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=mon_sinistre
DB_PASSWORD=
DB_NAME=mon_sinistre

# --- приложение ---
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# --- секреты ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
SALT_ROUNDS=12
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# true в продакшене — управляет флагом secure у cookie
HTTPS_ENABLED=false

# --- почта ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
