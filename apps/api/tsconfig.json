{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Покрывает и test/, scripts/, prisma/seed.ts, которые в сборку не идут.
    "rootDir": "./",
    "outDir": "./dist",
    "types": ["node", "jest"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    // @mon-sinistre/contracts is deliberately absent here. Mapping it to the package
    // sources would pull them under this project's rootDir and scatter dist/.
    // The workspace symlink resolves it to packages/contracts/dist instead,
    // which is why build:contracts has to run first.
    "paths": {
      "src/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "prisma/seed.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
