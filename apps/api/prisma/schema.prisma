// URL базы живёт в prisma.config.ts (собирается из DB_*), не здесь.
datasource db {
  provider = "postgresql"
}

// Генератор Prisma 7 "prisma-client" эмитит TypeScript в src/generated/prisma
// (вне node_modules); папка в .gitignore, перегенерация — npm run prisma:generate.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Справочник коммун на основе COG (docs/research/data-model.md § 3):
// идентичность по коду INSEE, история — через преемника. Устаревшие коды
// не удаляются: строка остаётся с effectiveTo и ссылкой на successor.
// Доменные даты — колонки date, не timestamp (правило проекта).
model Commune {
  codeInsee          String          @id
  name               String
  // Поисковый ключ названия: normalizeCommuneName(name), заполняется импортом.
  // Nullable до backfill (перезапуск идемпотентного импорта), затем NOT NULL
  // отдельной миграцией.
  nameNormalized     String?
  departementCode    String
  departementName    String
  // null = код действует в актуальном COG
  effectiveTo        DateTime?       @db.Date
  // куда влилась commune nouvelle; резолвится итеративно на чтении
  successorCodeInsee String?
  successor          Commune?        @relation("CommuneSuccessor", fields: [successorCodeInsee], references: [codeInsee], onDelete: Restrict)
  predecessors       Commune[]       @relation("CommuneSuccessor")
  sourceUrl          String
  sourceVerifiedAt   DateTime        @db.Date
  veilleCommunes     VeilleCommune[]
  arreteEntries      ArreteEntry[]

  // Префиксный поиск и сортировка: колонка объявлена COLLATE "C" (миграция
  // normalize_collation), поэтому обычный btree обслуживает и LIKE 'q%', и
  // ORDER BY — класс оператора text_pattern_ops больше не нужен. Collation
  // Prisma не поддерживает и в схеме не выражается: она живёт только в SQL
  // миграции, дрейфом не считается (проверка — commune-name-normalized.int-spec).
  @@index([nameNormalized])
}

// Подписка на уведомления об arrêté по выбранным коммунам — схема и решения:
// docs/research/veille-subscription-lifecycle.md. Токены хранятся хешами.
model Veille {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                String          @unique
  // null = подписка не подтверждена, писем об arrêté не получает
  confirmedAt          DateTime?       @db.Timestamptz(6)
  confirmTokenHash     String          @unique
  unsubscribeTokenHash String          @unique
  // Действует, пока confirmedAt null
  confirmExpiresAt     DateTime        @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  communes             VeilleCommune[]
  change               VeilleChange?

  // Индекс под часовую чистку — частичный, Prisma такие не выражает: CREATE
  // INDEX и причина живут в миграции veille_cleanup_indexes, дрейфом это не
  // считается — как collation у Commune.nameNormalized выше.
}

// Неподтверждённая заявка на смену состава коммун — docs/research/veille-commune-change.md.
// На рассылку не влияет: действующий состав — только VeilleCommune.
model VeilleChange {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  veilleId        String   @unique @db.Uuid
  veille          Veille   @relation(fields: [veilleId], references: [id], onDelete: Cascade)
  changeTokenHash String   @unique
  communeCodes    String[]
  expiresAt       DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
}

model VeilleCommune {
  veilleId  String  @db.Uuid
  codeInsee String
  veille    Veille  @relation(fields: [veilleId], references: [id], onDelete: Cascade)
  commune   Commune @relation(fields: [codeInsee], references: [codeInsee], onDelete: Restrict)

  @@id([veilleId, codeInsee])
  @@index([codeInsee])
}

// Счётчик писем формы veille (лимит частоты, фаза 3) —
// docs/research/veille-subscription-lifecycle.md.
model VeilleFormEmail {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  emailHash String
  sentAt    DateTime @default(now()) @db.Timestamptz(6)

  // Первый — счёт писем адресу за сутки, второй — часовая чистка по одному
  // sentAt: ведущая колонка составного индекса ей не подходит.
  @@index([emailHash, sentAt])
  @@index([sentAt])
}

enum ArreteEntryOutcome {
  RECONNU
  REFUSE
}

// Arrêté portant reconnaissance de l'état de catastrophe naturelle, найденный
// монитором JO. contentHash — по распарсенному содержимому, не сырому XML —
// почему: docs/research/jorf-monitor.md, «Дедупликация, contentHash и rectificatifs».
model Arrete {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Ключ дедупликации.
  nor           String        @unique
  signedAt      DateTime      @db.Date
  // Только из XML JORF — не дата появления файла в выгрузке DILA и не GASPAR
  // (жёсткое ограничение проекта).
  publishedAt   DateTime      @db.Date
  jorfNumber    String
  legifranceUrl String
  // Когда монитор впервые/последний раз встретил этот NOR в дельтах DILA.
  firstSeenAt   DateTime      @db.Timestamptz(6)
  lastSeenAt    DateTime      @db.Timestamptz(6)
  contentHash   String
  entries       ArreteEntry[]
}

// Одна строка annexe арретé — docs/research/data-model.md § 4.
model ArreteEntry {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  arreteId  String   @db.Uuid
  arrete    Arrete   @relation(fields: [arreteId], references: [id], onDelete: Cascade)
  // null = коммуна annexe не сопоставлена со справочником → алерт (фаза 2).
  codeInsee String?
  commune   Commune? @relation(fields: [codeInsee], references: [codeInsee], onDelete: Restrict)
  // Как напечатано в annexe — след для сверки и разбора несопоставленных строк.
  communeLabelRaw String
  departementRaw  String
  risque          String
  eventStart      DateTime           @db.Date
  eventEnd        DateTime           @db.Date
  outcome         ArreteEntryOutcome
  // Мотивация решения — хранится для обеих annexes (доказательный текст,
  // терять незачем), не только REFUSE — docs/research/jorf-monitor.md,
  // «Ограничения и риски».
  motivation      String?
  // Иммутабелен: когда строка появилась из JO — звено доказательной цепочки.
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  // Технический — «строку кто-то потрогал», включая ручную починку mapping'а;
  // в доказательствах не участвует (data-model § 4).
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  // unique(arreteId, codeInsee, risque, eventStart, eventEnd) где codeInsee
  // сопоставлен — партиальный unique, Prisma такое не выражает: CREATE UNIQUE
  // INDEX руками в миграции (общее правило § 1 data-model), дрейфом не
  // считается — как collation у Commune.nameNormalized выше.
}

// Прогресс монитора по дельтам DILA — docs/research/jorf-monitor.md,
// «Расписание прогонов». Строка появляется, когда дельта полностью
// обработана; необработанные дельты в таблице не отражены.
model JorfDelta {
  fileName    String   @id
  processedAt DateTime @db.Timestamptz(6)
}
