{
  "name": "jalons",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi des démarches de renouvellement des droits MDPH",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build:contracts": "npm run build --workspace @jalons/contracts",
    "build": "npm run build:contracts && npm run build --workspace @jalons/api && npm run build --workspace @jalons/web",
    "dev:contracts": "npm run dev --workspace @jalons/contracts",
    "dev:api": "npm run start:dev --workspace @jalons/api",
    "dev:web": "npm run dev --workspace @jalons/web",
    "test": "npm run test --workspace @jalons/api",
    "test:watch": "npm run test:watch --workspace @jalons/api",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose --env-file ./apps/api/.env up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
